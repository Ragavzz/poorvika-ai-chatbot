# Server Settings
HOST=127.0.0.1
PORT=8000
APP_NAME="ShopAI Backend"
ENVIRONMENT=development

# PostgreSQL Database Settings (Primary & Default)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=shopai

# Direct database URL override (optional, e.g. for Neon / Supabase / Cloud SQL)
# DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/shopai

# Local Ollama Configuration
OLLAMA_API_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3.2:latest
LAYA_DECIDE_URL=http://127.0.0.1:5056/decide
# Production defaults; opt into rules/disabled generation for a low-RAM demo.
DECISION_PROVIDER=laya
OLLAMA_ENABLED=true
SUGGESTION_TIMEOUT_SECONDS=45

# Dataset path (relative to project root)
DATASET_PATH=../data/poorvika_products.jsonl
